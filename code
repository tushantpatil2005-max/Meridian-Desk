        reason: { type: Type.STRING, description: "Short reason for the transfer." },
        priority: { type: Type.STRING, description: "Standard or Urgent." },
        summary: { type: Type.STRING, description: "Brief context summary for the receiving specialist." },
      },
      required: ["department", "reason", "summary"],
    },
  },
];

function executeTool(
  name: string,
  args: Record<string, unknown>,
  call: CallRecord
): Record<string, unknown> {
  if (name === "get_business_info") {
    const topic = String(args.topic ?? "all").toLowerCase();
    call.actions.push(`Looked up business info (${topic})`);
    if (topic === "hours") return { hours: BUSINESS.hours };
    if (topic === "location" || topic === "parking") {
      return { address: BUSINESS.address, parking: BUSINESS.parking };
    }
    if (topic === "services" || topic === "pricing") {
      return { services: BUSINESS.services };
    }
    if (topic === "insurance") return { insuranceAccepted: BUSINESS.insuranceAccepted };
    if (topic === "policy") return { cancellationPolicy: BUSINESS.cancellationPolicy };
    return { business: BUSINESS };
  }

  if (name === "check_availability") {
    const date = String(args.date ?? "2026-11-25");
    const bookedTimes = new Set(
      appointments
        .filter((a) => a.date === date && a.status === "Confirmed")
        .map((a) => a.time.toUpperCase())
    );
    const availableSlots = DAILY_SLOTS.filter((slot) => !bookedTimes.has(slot.toUpperCase()));
    call.actions.push(`Checked availability for ${date}`);
    return { date, availableSlots };
  }

  if (name === "schedule_appointment") {
    const date = String(args.date ?? "");
    const time = String(args.time ?? "");
    const conflict = appointments.find(
      (a) =>
        a.date === date &&
        a.time.toUpperCase() === time.toUpperCase() &&
        a.status === "Confirmed"
    );
    if (conflict) {
      return {
        booked: false,
        error: `The ${time} slot on ${date} is already reserved. Please offer another slot.`,
      };
    }

    const record: Appointment = {
      id: createId("APT"),
      callerName: String(args.callerName ?? "Unknown Caller"),
      callerPhone: String(args.callerPhone ?? call.callerNumber),
      service: String(args.service ?? "New Patient Consultation"),
      date,
      time,
      notes: String(args.notes ?? ""),
      status: "Confirmed",
      createdAt: new Date().toISOString(),
    };
    appointments.unshift(record);
    call.actions.push(`Scheduled ${record.id} for ${record.callerName} (${date} ${time})`);
    return { booked: true, appointment: record };
  }

  if (name === "cancel_appointment") {
    const id = String(args.appointmentId ?? "").toUpperCase();
    const callerName = String(args.callerName ?? "").toLowerCase();
    const match = appointments.find(
      (a) =>
        a.status === "Confirmed" &&
        ((id && a.id.toUpperCase() === id) ||
          (callerName && a.callerName.toLowerCase().includes(callerName)))
    );
    if (!match) {
      return { cancelled: false, message: "No matching confirmed appointment found." };
    }
    match.status = "Cancelled";
    call.actions.push(`Cancelled appointment ${match.id}`);
    return { cancelled: true, appointment: match };
  }

  if (name === "transfer_call") {
    const deptKey = String(args.department ?? "manager").toLowerCase();
    const target = DEPARTMENTS[deptKey] ?? DEPARTMENTS.manager;
    const record: TransferRecord = {
      id: createId("TRF"),
      callId: call.id,
      department: target.name,
      extension: target.extension,
      callerName: String(args.callerName ?? "Caller"),
      reason: String(args.reason ?? "Complex inquiry"),
      priority: String(args.priority ?? "Standard") === "Urgent" ? "Urgent" : "Standard",
      summary: String(args.summary ?? ""),
      timestamp: new Date().toISOString(),
    };
    transfers.unshift(record);
    call.status = "Transferred";
    call.actions.push(`Transferred to ${target.name} (Ext. ${target.extension})`);
    return {
      transferred: true,
      department: target.name,
      extension: target.extension,
      transferId: record.id,
    };
  }

  return { error: `Unknown tool: ${name}` };
}

function buildSystemInstruction(): string {
  return [
    `You are the front-desk phone receptionist for ${BUSINESS.name}.`,
    "Speak clearly, warmly, and concisely as on a real telephone call (1 to 3 short sentences per turn).",
    "Never use markdown formatting, bullet lists, or asterisks in spoken responses.",
    "Maintain full context across the entire call so callers do not have to repeat details.",
    "Answer common business questions using get_business_info.",
    "Before booking an appointment, check availability using check_availability and collect the caller's full name, requested service, preferred date, and time, then call schedule_appointment.",
    "For billing disputes, medical advice, urgent symptoms, or supervisor requests, briefly acknowledge the issue and call transfer_call with a clear summary for the receiving department.",
    "If the caller interrupts you mid-sentence, immediately stop your previous thought and address their new statement directly.",
    `Today's reference date is ${new Date().toISOString().slice(0, 10)}.`,
  ].join(" ");
}

