// ---------------------------------------------------------------------------
// Real-Time Full-Duplex Voice WebSocket Bridge (/ws/call)
// ---------------------------------------------------------------------------

const server = http.createServer(app);
const wss = new WebSocketServer({ server, path: "/ws/call" });

wss.on("connection", async (ws: WebSocket) => {
  const call: CallRecord = {
    id: createId("CALL"),
    callerNumber: "(415) 555-0199",
    startedAt: new Date().toISOString(),
    status: "Active",
    interruptionCount: 0,
    transcript: [],
    actions: ["Call answered"],
  };
  callHistory.unshift(call);

  let currentInputBuffer = "";
  let currentOutputBuffer = "";
  let sessionClosed = false;

  const safeSend = (payload: Record<string, unknown>) => {
    if (ws.readyState === WebSocket.OPEN) {
      ws.send(JSON.stringify(payload));
    }
  };

  safeSend({ type: "call_started", callId: call.id });

  try {
    const liveSession = await client.live.connect({
      model: "gemini-3.8-live",
      config: {
        responseModalities: [Modality.AUDIO],
        speechConfig: {
          voiceConfig: { prebuiltVoiceConfig: { voiceName: "Kore" } },
        },
        inputAudioTranscription: {},
        outputAudioTranscription: {},
        tools: [{ functionDeclarations: RECEPTIONIST_TOOLS }],
        systemInstruction: buildSystemInstruction(),
      },
      callbacks: {
        onmessage: (message: LiveServerMessage) => {
          const serverContent = message.serverContent;

          if (serverContent?.interrupted) {
            call.interruptionCount += 1;
            if (currentOutputBuffer.trim()) {
              call.transcript.push({
                id: createId("MSG"),
                speaker: "Receptionist",
                text: currentOutputBuffer.trim(),
                timestamp: new Date().toISOString(),
                interrupted: true,
              });
              currentOutputBuffer = "";
            }
            call.actions.push("Caller interrupted receptionist");
            safeSend({ type: "interrupted", count: call.interruptionCount });
          }

          if (serverContent?.inputTranscription?.text) {
            currentInputBuffer += serverContent.inputTranscription.text;
            safeSend({ type: "transcript_delta", speaker: "Caller", text: currentInputBuffer });
          }

          if (serverContent?.outputTranscription?.text) {
            if (currentInputBuffer.trim()) {
              const entry: TranscriptEntry = {
                id: createId("MSG"),
                speaker: "Caller",
                text: currentInputBuffer.trim(),
                timestamp: new Date().toISOString(),
              };
              call.transcript.push(entry);
              safeSend({ type: "transcript_final", entry });
              currentInputBuffer = "";
            }
            currentOutputBuffer += serverContent.outputTranscription.text;
            safeSend({
              type: "transcript_delta",
              speaker: "Receptionist",
              text: currentOutputBuffer,
            });
          }

          for (const part of serverContent?.modelTurn?.parts ?? []) {
            if (part.inlineData?.data) {
              safeSend({ type: "audio", data: part.inlineData.data });
            }
          }

          if (serverContent?.turnComplete) {
            if (currentInputBuffer.trim()) {
              const entry: TranscriptEntry = {
                id: createId("MSG"),
                speaker: "Caller",
                text: currentInputBuffer.trim(),
                timestamp: new Date().toISOString(),
              };
              call.transcript.push(entry);
              safeSend({ type: "transcript_final", entry });
              currentInputBuffer = "";
            }
            if (currentOutputBuffer.trim()) {
              const entry: TranscriptEntry = {
                id: createId("MSG"),
                speaker: "Receptionist",
                text: currentOutputBuffer.trim(),
                timestamp: new Date().toISOString(),
              };
              call.transcript.push(entry);
              safeSend({ type: "transcript_final", entry });
              currentOutputBuffer = "";
            }
            safeSend({ type: "turn_complete" });
          }

          const functionCalls = message.toolCall?.functionCalls;
          if (functionCalls && functionCalls.length > 0) {
            const functionResponses = functionCalls.map((fc) => {
              const result = executeTool(
                fc.name ?? "",
                (fc.args as Record<string, unknown>) ?? {},
                call
              );
              safeSend({ type: "tool_event", name: fc.name, args: fc.args, result });
              return {
                id: fc.id,
                name: fc.name ?? "",
                response: result,
              };
            });
            liveSession.sendToolResponse({ functionResponses });
            safeSend({ type: "state_sync", appointments, transfers });
          }
        },
        onerror: (err: ErrorEvent) => {
          safeSend({ type: "error", message: err.message || "Voice stream error" });
        },
        onclose: () => {
          sessionClosed = true;
          safeSend({ type: "call_ended", callId: call.id });
        },
      },
    });

    // Prompt initial greeting as soon as line connects
    liveSession.sendClientContent({
      turns: [
        {
          role: "user",
          parts: [
            {
              text: "An incoming phone call just connected. Answer the phone politely with your standard greeting.",
            },
          ],
        },
      ],
      turnComplete: true,
    });

    ws.on("message", (raw) => {
      if (sessionClosed) return;
      try {
        const msg = JSON.parse(raw.toString()) as {
          type?: string;
          audio?: string;
          text?: string;
        };
        if (msg.type === "audio" && msg.audio) {
          liveSession.sendRealtimeInput({
            audio: { data: msg.audio, mimeType: "audio/pcm;rate=16000" },
          });
        } else if (msg.type === "text" && msg.text) {
          const entry: TranscriptEntry = {
            id: createId("MSG"),
            speaker: "Caller",
            text: msg.text,
            timestamp: new Date().toISOString(),
          };
          call.transcript.push(entry);
          safeSend({ type: "transcript_final", entry });
          liveSession.sendClientContent({
            turns: [{ role: "user", parts: [{ text: msg.text }] }],
            turnComplete: true,
          });
        }
      } catch {
        // Ignore malformed frame
      }
    });

    ws.on("close", () => {
      call.endedAt = new Date().toISOString();
      if (call.status === "Active") call.status = "Completed";
      if (!sessionClosed) {
        sessionClosed = true;
        liveSession.close();
      }
    });
  } catch (err) {
    const message = err instanceof Error ? err.message : "Unable to start voice session";
    safeSend({ type: "error", message });
    ws.close();
  }
});

