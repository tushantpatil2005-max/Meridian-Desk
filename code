// ---------------------------------------------------------------------------
// Domain Types
// ---------------------------------------------------------------------------

interface BusinessProfile {
  name: string;
  phone: string;
  address: string;
  parking: string;
  hours: Record<string, string>;
  services: Array<{ name: string; durationMinutes: number; price: string }>;
  insuranceAccepted: string[];
  cancellationPolicy: string;
}

interface Appointment {
  id: string;
  callerName: string;
  callerPhone: string;
  service: string;
  date: string;
  time: string;
  notes: string;
  status: "Confirmed" | "Cancelled";
  createdAt: string;
}

interface TransferRecord {
  id: string;
  callId: string;
  department: string;
  extension: string;
  callerName: string;
  reason: string;
  priority: "Standard" | "Urgent";
  summary: string;
  timestamp: string;
}

interface TranscriptEntry {
  id: string;
  speaker: "Caller" | "Receptionist" | "System";
  text: string;
  timestamp: string;
  interrupted?: boolean;
}

interface CallRecord {
  id: string;
  callerNumber: string;
  startedAt: string;
  endedAt?: string;
  status: "Active" | "Completed" | "Transferred";
  interruptionCount: number;
  transcript: TranscriptEntry[];
  actions: string[];
}

