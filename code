    let nextStartTime = 0, activeSources = [];
    const statusEl = document.getElementById("status");
    const transcriptEl = document.getElementById("transcript");
    const stateEl = document.getElementById("stateView");
    const startBtn = document.getElementById("startBtn");
    const bargeBtn = document.getElementById("bargeBtn");
    const endBtn = document.getElementById("endBtn");

    function floatTo16BitPcmBase64(float32) {
      const pcm = new Int16Array(float32.length);
      for (let i = 0; i < float32.length; i++) {
        const s = Math.max(-1, Math.min(1, float32[i]));
        pcm[i] = s < 0 ? s * 0x8000 : s * 0x7fff;
      }
      const bytes = new Uint8Array(pcm.buffer);
      let bin = "";
      for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
      return btoa(bin);
    }

    function stopPlayback() {
      for (const src of activeSources) { try { src.stop(); } catch {} }
      activeSources = [];
      if (outputCtx) nextStartTime = outputCtx.currentTime;
    }

    function playPcm24k(base64) {
      if (!outputCtx) return;
      const bin = atob(base64);
      const bytes = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
      const pcm16 = new Int16Array(bytes.buffer);
      const audioBuf = outputCtx.createBuffer(1, pcm16.length, 24000);
      const ch = audioBuf.getChannelData(0);
      for (let i = 0; i < pcm16.length; i++) ch[i] = pcm16[i] / 32768;
      const src = outputCtx.createBufferSource();
      src.buffer = audioBuf;
      src.connect(outputCtx.destination);
      const startAt = Math.max(outputCtx.currentTime, nextStartTime);
      src.start(startAt);
      nextStartTime = startAt + audioBuf.duration;
      activeSources.push(src);
      src.onended = () => { activeSources = activeSources.filter((x) => x !== src); };
    }

    function appendMessage(speaker, text) {
      const div = document.createElement("div");
      div.className = "msg " + (speaker === "Receptionist" ? "receptionist" : "");
      div.innerHTML = "<div class='meta'>" + speaker + "</div><div>" + text.replace(/</g, "&lt;") + "</div>";
      transcriptEl.appendChild(div);
      transcriptEl.scrollTop = transcriptEl.scrollHeight;
    }

    async function refreshState() {
      const res = await fetch("/api/state");
      const data = await res.json();
      stateEl.textContent = JSON.stringify({ appointments: data.appointments, transfers: data.transfers }, null, 2);
    }

    startBtn.onclick = async () => {
      const proto = location.protocol === "https:" ? "wss" : "ws";
      ws = new WebSocket(proto + "://" + location.host + "/ws/call");
      outputCtx = new AudioContext({ sampleRate: 24000 });
      nextStartTime = outputCtx.currentTime;
      statusEl.textContent = "Connecting line...";
      startBtn.disabled = true;
      endBtn.disabled = false;
      bargeBtn.disabled = false;

      ws.onopen = async () => {
        statusEl.textContent = "Call active";
        try {
          inputCtx = new AudioContext({ sampleRate: 16000 });
          mediaStream = await navigator.mediaDevices.getUserMedia({ audio: true });
          const src = inputCtx.createMediaStreamSource(mediaStream);
          processor = inputCtx.createScriptProcessor(4096, 1, 1);
          src.connect(processor);
          processor.connect(inputCtx.destination);
          processor.onaudioprocess = (e) => {
            if (ws && ws.readyState === WebSocket.OPEN) {
              const samples = e.inputBuffer.getChannelData(0);
              ws.send(JSON.stringify({ type: "audio", audio: floatTo16BitPcmBase64(samples) }));
            }
          };
        } catch {
          statusEl.textContent = "Call active (microphone unavailable; use text input)";
        }
      };

      ws.onmessage = (e) => {
        const msg = JSON.parse(e.data);
        if (msg.type === "audio") playPcm24k(msg.data);
        if (msg.type === "interrupted") { stopPlayback(); statusEl.textContent = "Interrupted - listening"; }
        if (msg.type === "transcript_final") appendMessage(msg.entry.speaker, msg.entry.text);
        if (msg.type === "state_sync") refreshState();
        if (msg.type === "error") statusEl.textContent = "Error: " + msg.message;
      };

      ws.onclose = () => {
        stopPlayback();
        if (processor) processor.disconnect();
        if (mediaStream) mediaStream.getTracks().forEach((t) => t.stop());
        if (inputCtx) inputCtx.close();
        if (outputCtx) outputCtx.close();
        startBtn.disabled = false;
        endBtn.disabled = true;
        bargeBtn.disabled = true;
        statusEl.textContent = "Call ended";
        refreshState();
      };
    };

    bargeBtn.onclick = () => {
      stopPlayback();
      statusEl.textContent = "Playback interrupted - listening";
    };

    endBtn.onclick = () => { if (ws) ws.close(); };

    document.getElementById("textForm").onsubmit = (e) => {
      e.preventDefault();
      const input = document.getElementById("textInput");
      const text = input.value.trim();
      if (!text || !ws || ws.readyState !== WebSocket.OPEN) return;
      stopPlayback();
      ws.send(JSON.stringify({ type: "text", text }));
      input.value = "";
    };

    refreshState();
  </script>
</body>
</html>`;

// Only listen when executed directly as the standalone script
const isMainModule =
  typeof process !== "undefined" &&
  process.argv[1] &&
  process.argv[1].endsWith("receptionist.ts");

if (isMainModule) {
  const PORT = Number(process.env.PORT || 3000);
  server.listen(PORT, "0.0.0.0", () => {
    console.log(`Meridian Voice Receptionist listening on http://localhost:${PORT}`);
  });
}

export { server, app };
