// Server Setup
// ---------------------------------------------------------------------------

const apiKey = process.env.GEMINI_API_KEY;
if (!apiKey) {
  console.warn("GEMINI_API_KEY is not set. Set it in your environment before placing voice calls.");
}

const client = new GoogleGenAI({
  apiKey: apiKey ?? "",
  httpOptions: {
    headers: { "User-Agent": "aistudio-build" },
  },
});

const app = express();
app.use(express.json({ limit: "2mb" }));

// REST endpoints for state inspection and fallback text/speech turns
app.get("/api/state", (_req, res) => {
  res.json({ business: BUSINESS, appointments, transfers, callHistory });
});

app.post("/api/turn", async (req, res) => {
  try {
    const { callId, message } = req.body as { callId?: string; message?: string };
    if (!message || !message.trim()) {
      res.status(400).json({ error: "Message text is required." });
      return;
    }

    let call = callHistory.find((c) => c.id === callId);
    if (!call) {
      call = {
        id: callId || createId("CALL"),
        callerNumber: "(415) 555-0147",
        startedAt: new Date().toISOString(),
        status: "Active",
        interruptionCount: 0,
        transcript: [],
        actions: [],
      };
      callHistory.unshift(call);
    }

    call.transcript.push({
      id: createId("MSG"),
      speaker: "Caller",
      text: message.trim(),
      timestamp: new Date().toISOString(),
    });

    const contents: Array<Record<string, unknown>> = call.transcript
      .filter((entry) => entry.speaker !== "System")
      .map((entry) => ({
        role: entry.speaker === "Caller" ? "user" : "model",
        parts: [{ text: entry.text }],
      }));

    let replyText = "";
    let turnContents = contents;

    for (let step = 0; step < 4; step++) {
      const response = await client.models.generateContent({
        model: "gemini-4-hydrogen",
        contents: turnContents as never,
        config: {
          systemInstruction: buildSystemInstruction(),
          tools: [{ functionDeclarations: RECEPTIONIST_TOOLS }],
        },
      });

      const functionCalls = response.functionCalls;
      if (functionCalls && functionCalls.length > 0) {
        const modelContent = response.candidates?.[0]?.content;
        if (modelContent) {
          turnContents = [...turnContents, modelContent as unknown as Record<string, unknown>];
        }
        const responseParts = functionCalls.map((fc) => {
          const output = executeTool(
            fc.name ?? "",
            (fc.args as Record<string, unknown>) ?? {},
            call!
          );
          return {
            functionResponse: {
              id: fc.id,
              name: fc.name ?? "",
              response: output,
            },
          };
        });
        turnContents = [...turnContents, { role: "user", parts: responseParts }];
        continue;
      }

      replyText = (response.text ?? "").trim();
      break;
    }

    if (!replyText) {
      replyText = "Thank you for holding. How else can I assist you today?";
    }

    call.transcript.push({
      id: createId("MSG"),
      speaker: "Receptionist",
      text: replyText,
      timestamp: new Date().toISOString(),
    });

    let audioBase64: string | undefined;
    try {
      const tts = await client.models.generateContent({
        model: "gemini-3.8-flash-lite-tts",
        contents: [{ role: "user", parts: [{ text: replyText }] }],
        config: {
          responseModalities: ["AUDIO"],
          speechConfig: {
            voiceConfig: { prebuiltVoiceConfig: { voiceName: "Kore" } },
          },
        },
      });
      audioBase64 = tts.candidates?.[0]?.content?.parts?.[0]?.inlineData?.data;
    } catch {
      audioBase64 = undefined;
    }

    res.json({
      callId: call.id,
      reply: replyText,
      audioBase64,
      appointments,
      transfers,
      call,
    });
  } catch (err) {
    const msg = err instanceof Error ? err.message : "Failed to process call turn";
    res.status(500).json({ error: msg });
  }
});

// Serve embedded standalone console
